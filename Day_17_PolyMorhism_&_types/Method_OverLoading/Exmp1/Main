public class Main {
	public static void main(String[] args) {
		Login login = new Login();
		login.login("San@gmail.com");
		
		login.login("San@gmail.com","San@123");
		
		
		login.login(652156465);
		System.out.println();
		login.login("San@gmail.com","San@123");
		
		
		login.login("San@gmail.com","San@123");
		
	}

}
